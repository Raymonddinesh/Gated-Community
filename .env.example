# SocietySphere Environment Configuration Template
# Copy to .env for local development. NEVER commit real secrets to source control.

# Application Metadata
APP_NAME=SocietySphere
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Security & CORS
# Comma-separated allowed origins (do NOT use '*' in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Secret Keys (Generate secure random keys for production)
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/societysphere_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=5

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_ENABLED=true
RABBITMQ_CONNECTION_TIMEOUT=5

# S3-Compatible Object Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=societysphere-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
MAX_REQUEST_SIZE_BYTES=10485760 # 10MB
